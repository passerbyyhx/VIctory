<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="VIctory local test">
  <Profiles>
    <SystemCollector Id="WaitCollector" Name="VI3 XMA waits"><BufferSize Value="256"/><Buffers Value="128"/></SystemCollector>
    <SystemProvider Id="WaitProvider">
      <Keywords><Keyword Value="ProcessThread"/><Keyword Value="Loader"/><Keyword Value="CSwitch"/><Keyword Value="ReadyThread"/></Keywords>
      <Stacks><Stack Value="CSwitch"/><Stack Value="ReadyThread"/></Stacks>
    </SystemProvider>
    <Profile Id="XmaWait.Verbose.File" Name="XmaWait" Description="XMA scheduler wait attribution" LoggingMode="File" DetailLevel="Verbose">
      <Collectors><SystemCollectorId Value="WaitCollector"><SystemProviderId Value="WaitProvider"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
